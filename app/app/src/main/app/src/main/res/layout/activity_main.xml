<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101A2B"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REDZONE PRO HUD // S24 ONE UI 9"
            android:textColor="#56B4FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#17243B"
            android:padding="12dp"
            android:text="Cargando telemetría del sistema..."
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnBoost"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#FF5500"
            android:text="ACTIVAR MODO COMPETITIVO (120HZ + TOUCH)"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRestore"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#17243B"
            android:text="RESTAURAR MODO NORMAL"
            android:textColor="#56B4FF" />

        <Button
            android:id="@+id/btnCrosshair"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#56B4FF"
            android:text="ACTIVAR / DESACTIVAR MIRA FLOTANTE"
            android:textColor="#101A2B"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="DRAG-SHOT LAB (Practica levantar mira aquí)"
            android:textColor="#FF5500"
            android:textStyle="bold" />

        <com.htown.redzonepro.DragLabView
            android:id="@+id/dragLab"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="8dp"
            android:background="#17243B" />

        <TextView
            android:id="@+id/txtTelemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#17243B"
            android:padding="12dp"
            android:text="Desliza hacia arriba desde el círculo para medir tu velocidad de headshot."
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
